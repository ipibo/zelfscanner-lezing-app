# Het pack op het device krijgt geen media: die staan bij de runner en gaan naar
# de beamer. Wat hier wel lokaal blijft is settings.json, want daar staat het
# ip-adres van de laptop in waar dit apparaat op aangesloten was.
pack/settings.json

# personal Claude Code permission config, not shared tooling
.claude/settings.local.json
